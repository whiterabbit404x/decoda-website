# Contact / demo form email delivery.
#
# These are read server-side only (in app/api/contact and lib/email.ts).
# Copy this file to `.env.local` and fill in real values. NEVER commit real
# secrets — `.env.local` is git-ignored.
#
# IN PRODUCTION these must be set on the hosting platform (Vercel →
# Project → Settings → Environment Variables, Production scope) and the project
# must be REDEPLOYED afterwards — Vercel only injects env vars into a new
# deployment. Without RESEND_API_KEY the form fails with a 502 and the visitor
# sees "We couldn't send your request".

# Resend API key. Create one at https://resend.com/api-keys
# REQUIRED — the contact form cannot send without it.
RESEND_API_KEY=

# Destination inbox for all contact/demo submissions. The recipient is always
# resolved from this variable server-side and can never be set by the browser.
CONTACT_TO_EMAIL=hello@decodasecurity.com

# Verified sender used in the "From" header. The domain MUST be verified in the
# Resend account (https://resend.com/domains) or every send is rejected with
# 403 "domain is not verified". The visitor's own email is used only as
# reply-to, never as the sender.
#
# WARNING when setting this in a hosting dashboard (Vercel, etc.): paste the
# value WITHOUT quotes —
#     Decoda Website <noreply@decodasecurity.com>
# A dashboard stores quotes literally (unlike a .env parser, which strips them),
# and a quoted value is not a valid address, so every send is rejected.
CONTACT_FROM_EMAIL=Decoda Website <noreply@decodasecurity.com>

# Optional. Set to "false" to skip the acknowledgment email sent to the visitor.
# Defaults to enabled.
CONTACT_SEND_CONFIRMATION=true

# Optional. Overrides the Resend API base URL. Only used to point the send path
# at a local stub during testing; leave unset in every real environment.
# RESEND_BASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Decoda Platform: shared identity, Request Pilot, platform admin.
# See docs/identity/MIGRATION_PLAN.md. Server-side only unless prefixed
# NEXT_PUBLIC_. Every identity surface FAILS CLOSED when these are missing: no
# demo, mock or legacy fallback exists.
# ─────────────────────────────────────────────────────────────────────────────

# WorkOS — the "Decoda Website" APPLICATION in the WorkOS environment for this
# stage (staging vs production are separate WorkOS environments). Names are the
# ones the official SDK (@workos-inc/authkit-nextjs) reads.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
# >= 32 random characters; encrypts the HttpOnly `wos-session` cookie. Unique
# per application — never share it with Guard or Vault.
#   openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=
# Must exactly match the Website application's redirect URI in WorkOS.
# Production: https://www.decodasecurity.com/auth/callback (https, no localhost).
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
# Leave WORKOS_COOKIE_DOMAIN UNSET: sessions are host-only per application.

# Secret of the webhook endpoint https://www.decodasecurity.com/api/webhooks/workos
WORKOS_WEBHOOK_SECRET=

# Platform database (Neon), OWNER / read-write role. Products use a separate
# read-only role (decoda_platform_reader) with SELECT on platform_api views only.
DECODA_PLATFORM_DATABASE_URL=postgresql://decoda:decoda@127.0.0.1:5432/decoda_platform_dev
# Optional: role granted the product contract after each migration.
# DECODA_PLATFORM_READER_ROLE=decoda_platform_reader

# HMAC key (>= 32 chars) for platform CSRF tokens, Request Pilot form tokens and
# client-IP hashing. Distinct from WORKOS_COOKIE_PASSWORD.
#   openssl rand -base64 48
DECODA_PLATFORM_SECRET=

# Set to "production" on the production deployment if not running on Vercel
# (VERCEL_ENV=production is honoured automatically). Production refuses http
# and localhost URLs.
# DECODA_ENV=production

# Product destinations (defaults are the production domains).
DECODA_WEBSITE_URL=http://localhost:3000
DECODA_RWA_GUARD_URL=https://rwa.decodasecurity.com
DECODA_VAULT_URL=https://vault.decodasecurity.com
DECODA_ASSETS_URL=https://assets.decodasecurity.com

# Request Pilot email (uses RESEND_API_KEY above).
PILOT_NOTIFICATION_EMAIL=hello@decodasecurity.com
PILOT_FROM_EMAIL=Decoda <noreply@decodasecurity.com>
PILOT_SEND_CONFIRMATION=true

# Days a WorkOS invitation stays valid (1–30, default 7).
DECODA_INVITATION_EXPIRES_DAYS=7
